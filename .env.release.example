# Copy to .env.release (gitignored) and fill in. npm run release reads it.
# A store whose values are missing is skipped.

# Chrome Web Store: https://github.com/fregante/chrome-webstore-upload-keys
EXTENSION_ID=
PUBLISHER_ID=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Firefox Add-ons: https://addons.mozilla.org/developers/addon/api/key/
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=
